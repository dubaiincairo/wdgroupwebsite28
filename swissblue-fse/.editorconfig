# EditorConfig — https://editorconfig.org
# WordPress conventions: tab indentation for PHP, 2-space for JS / CSS / JSON.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{js,jsx,ts,mjs,cjs,css,scss,json,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{po,pot}]
trim_trailing_whitespace = false
