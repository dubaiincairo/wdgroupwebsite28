{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "swissblue/gallery-carousel",
	"version": "0.1.0",
	"title": "Gallery Carousel",
	"category": "swissblue",
	"icon": "images-alt2",
	"description": "RTL-aware image carousel built on native CSS scroll-snap (no auto-play, per DESIGN_SYSTEM §10.4; directional behaviour per §11.3).",
	"keywords": ["swissblue", "gallery", "carousel"],
	"textdomain": "swissblue-fse",
	"attributes": {
		"images": { "type": "array", "default": [] }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"]
	},
	"editorScript": "swissblue-gallery-carousel-editor",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
