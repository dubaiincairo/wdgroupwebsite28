{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "swissblue/amenity-grid",
	"version": "0.1.0",
	"title": "Amenity Grid",
	"category": "swissblue",
	"icon": "grid-view",
	"description": "Responsive grid of amenity icons and labels (4 / 2 / 1 columns). Follows the iconography rules in DESIGN_SYSTEM §9 and the grid spec §7.4.",
	"keywords": ["swissblue", "amenity", "grid"],
	"textdomain": "swissblue-fse",
	"attributes": {
		"heading": { "type": "string", "default": "" },
		"items": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide"]
	},
	"editorScript": "swissblue-amenity-grid-editor",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
