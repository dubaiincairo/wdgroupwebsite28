{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "swissblue/booking-sticky-bar",
	"version": "0.1.0",
	"title": "Booking Sticky Bar",
	"category": "swissblue",
	"icon": "money-alt",
	"description": "Fixed bottom price bar with grand total and a Continue CTA. Implements DESIGN_SYSTEM §8.8 (Sticky Bottom Price Bar); the source orange CTA is adapted to the SwissBlue primary.",
	"keywords": ["swissblue", "booking", "sticky"],
	"textdomain": "swissblue-fse",
	"attributes": {
		"totalLabel": { "type": "string", "default": "Grand Total" },
		"price": { "type": "string", "default": "" },
		"currency": { "type": "string", "default": "SAR" },
		"ctaText": { "type": "string", "default": "Continue" },
		"ctaUrl": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false
	},
	"editorScript": "swissblue-booking-sticky-bar-editor",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
